# ── LangGraph checkpoint 数据库（可选；留空使用进程内 checkpoint）──
DATABASE_URL=

# ── 服务端口 ──
PORT=6001

# ── management-system 地址 ──
MANAGEMENT_SYSTEM_URL=http://127.0.0.1:5002

# ── 多租户存储与认证 ──
DIAGNOSIS_ENV=production
# 生产环境建议挂载独立持久化卷，不要放在代码目录。
DIAGNOSIS_STORAGE_ROOT=/var/lib/diagnosis-agent
# 可选：允许 local_logs 读取当前用户的 management-system 工作区。
DIAGNOSIS_USER_WORKSPACES_ROOT=/opt/management-system/backend/runtime/users
# management-system 内部代理调用时，双方配置相同的强随机值。
DIAGNOSIS_INTERNAL_TOKEN=replace-with-a-long-random-secret
# 允许携带 management-system Session Cookie 的前端来源。
DIAGNOSIS_CORS_ORIGINS=http://127.0.0.1:5002,http://localhost:5002
# 生产环境必须保持 false。
DIAGNOSIS_ALLOW_ANONYMOUS=false
# 单文件上传上限，默认 2 GiB。
DIAGNOSIS_UPLOAD_MAX_BYTES=2147483648
# 文件队列 Worker 扫描间隔（秒）；Worker 本身不占端口。
DIAGNOSIS_WORKER_POLL_SECONDS=1

# ── 6001 默认运行时与 Claude CLI ──
DIAGNOSIS_DEFAULT_RUNTIME=claude-origin-v1
CLAUDE_BIN=claude
# 可选：Anthropic-compatible 网关和认证。认证值不要提交到仓库。
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
# 生产环境可指向随发布包提供的完整 Skills 根目录；默认使用项目内 skills/。
DIAGNOSIS_SKILLS_ROOT=
CLAUDE_TIMEOUT_SECONDS=1200
CLAUDE_MAX_BUDGET_USD=

# ── jz-claude-skills 路径（已废弃，engine 已自包含）──
# JZ_SKILLS_ROOT=../jz-claude-skills
